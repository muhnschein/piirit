[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-postivene
Exec=harbour-postivene
Name=Postivene
Name[fi]=Postivene
Comment=Delta Chat client
Categories=Network;InstantMessaging;
# One instance: a share arrives at the app that is already running, and a
# second copy of a chat client is not a thing anybody wants.
X-Nemo-Single-Instance=yes

# What the platform's share sheet offers when something is shared to this
# app -- a picture from the gallery, a link from the browser, a file from
# the file manager. Each name here has a group below it and a
# `ShareProvider` of the same name in qml/share/ShareTarget.qml; the
# provider is what receives the file or the text, and a name in one place
# and not the other is a method that is offered and does nothing.
X-Share-Methods=files;text

