# Rust
/target/
**/target/
Cargo.lock.bak

# Sailfish SDK / mb2 / sfdk
RPMS/
*.rpm
build-*/
*.spec.bak

# %build temps; not /tmp (scratchbox2 parallel link loses files)
/.tmp/

# Compiled from .ts (scripts/release-translations.sh)
*.qm

# Qt Creator / QML
*.pro.user
*.pro.user.*
.qmake.stash

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# scripts/fetch-rpc-server.sh; see vendor/deltachat-rpc-server/SOURCE.md
/vendor/deltachat-rpc-server/*/

# `cargo vendor` for OBS/Chum, SDK chroot (no crates.io). From
# scripts/vendor-crates.sh; see docs/BUILDING.md "Building without network
# access"
/rpm/vendor.tar.xz
/rpm/vendor.toml
/rust/vendor/
/rust/.cargo/
# Except shared setting: see .cargo/config.toml
/.cargo/*
!/.cargo/config.toml

# Python 3 leaves beside tools/faces/faces.py
__pycache__/
